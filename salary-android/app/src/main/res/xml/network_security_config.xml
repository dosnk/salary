<?xml version="1.0" encoding="utf-8"?>
<!--
    网络安全配置

    背景（2026-09-12 修复）：本系统为内网部署，后端通过 docker-compose 以明文 HTTP 提供服务
    （如 http://192.168.1.68:9393），且服务器地址允许用户自定义（任意局域网 IP 或域名），
    无法用 domain 白名单穷举。此前 base-config 禁止明文导致新包登录报
    "CLEARTEXT communication ... not permitted by network security policy"。

    决策：全局允许明文 HTTP 流量，匹配内网业务系统部署形态。
    若未来启用 HTTPS，可改回 cleartextTrafficPermitted="false" 并配置 domain-config 白名单。
-->
<network-security-config>
    <!-- 全局默认配置：允许明文 HTTP（内网部署，服务器地址可配置） -->
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
